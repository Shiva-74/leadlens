# PostgreSQL connection string (Neon free tier recommended)
DATABASE_URL=postgresql://user:password@ep-hostname.region.aws.neon.tech/neondb?sslmode=require

# NVIDIA NIM API Key (for nvidia/nemotron-3-nano-30b-a3b)
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# Groq API Key (optional for text fallback, primary for Whisper voice transcription)
GROQ_API_KEY=

# Google Gemini API Key (optional for text & audio transcription fallback)
GEMINI_API_KEY=

# Port for the Express server
PORT=3000